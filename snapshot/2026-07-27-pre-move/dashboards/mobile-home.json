              "styles": ".bubble-sub-button-1 > ha-icon { color: ${['triggered','pending'].includes(hass.states['alarm_control_panel.home_alarm'].state) ? 'var(--error-color)' : ['armed_away','armed_home','armed_night','arming'].includes(hass.states['alarm_control_panel.home_alarm'].state) ? 'var(--warning-color)' : 'var(--success-color)'} !important; }\n.bubble-sub-button-2 > ha-icon { color: var(--error-color) !important; }\n.bubble-sub-button-3 > ha-icon { color: var(--error-color) !important; }\n.bubble-sub-button-4 > ha-icon { color: ${(hass.states['input_boolean.everyone_sleeping'].state === 'on' || parseInt(hass.states['zone.home'].state) < 1) ? 'var(--error-color)' : 'var(--warning-color)'} !important; }\n.bubble-sub-button-5 > ha-icon { color: ${hass.states['cover.garage_door'].state !== 'closed' ? ((hass.states['input_boolean.everyone_sleeping'].state === 'on' || parseInt(hass.states['zone.home'].state) < 1) ? 'var(--error-color)' : 'var(--warning-color)') : 'var(--success-color)'} !important; }\n.bubble-sub-button-7 > ha-icon { color: ${parseInt(hass.states['sensor.toledo_ohio_usa_air_quality_index'].state) >= 126 ? 'var(--error-color)' : parseInt(hass.states['sensor.toledo_ohio_usa_air_quality_index'].state) >= 101 ? 'var(--accent-color)' : 'var(--success-color)'} !important; }\n.bubble-sub-button-8 > ha-icon { color: ${hass.states['input_boolean.guest_mode'].state === 'on' ? 'var(--success-color)' : 'var(--disabled-color)'} !important; }\n.bubble-sub-button-9 > ha-icon { color: ${hass.states['input_boolean.avery_sleeping'].state === 'on' ? 'var(--success-color)' : 'var(--disabled-color)'} !important; }\n.bubble-sub-button-10 > ha-icon { color: var(--accent-color) !important; }\n.bubble-sub-button-11 > ha-icon { color: ${hass.states['climate.living_room_thermostat'].attributes.hvac_action === 'cooling' ? 'var(--info-color)' : hass.states['climate.living_room_thermostat'].attributes.hvac_action === 'heating' ? 'var(--warning-color)' : 'var(--disabled-color)'} !important; }\n.bubble-sub-button-12 > ha-icon { color: ${hass.states['input_boolean.vacuum_routine_pause'].state === 'on' ? 'var(--warning-color)' : ['cleaning','returning','paused'].includes(hass.states['vacuum.roborock_q8_max'].state) ? 'var(--warning-color)' : (hass.states['sensor.roborock_q8_max_vacuum_error'].state !== 'none' || hass.states['sensor.roborock_q8_max_dock_error'].state !== 'ok') ? 'var(--error-color)' : hass.states['input_select.vacuum_ran_today'].state !== 'Yes' ? 'var(--disabled-color)' : 'var(--success-color)'} !important; }\n.bubble-sub-button-15 > ha-icon { color: ${(() => { const sensors = Object.keys(hass.states).filter(e => e.startsWith('sensor.household_chores_')); const anyOverdue = sensors.some(s => hass.states[s].state === 'overdue'); const anyDue = sensors.some(s => hass.states[s].state === 'due'); const trashPending = hass.states['input_boolean.trash_pickup_pending']?.state === 'on'; return anyOverdue ? 'var(--error-color)' : (anyDue || trashPending) ? 'var(--warning-color)' : 'var(--disabled-color)'; })()} !important; }",
