{#-
  Facts sent to Claude by script.household_ai_briefing and _weekly_digest
  (guides/ai_insights.md). These macros ARE the allowlist: anything not listed
  here is never sent. Never add coordinates, lock codes, network details, camera
  images, or calendars.

  Deployed to /config/custom_templates/ai_insights.jinja; reload with
  homeassistant.reload_custom_templates after every change.

  Everything the model would otherwise have to work out (highs and lows and
  their times, rain windows, the gap to yesterday) is computed here, so the
  model only has to write.
-#}

{#- hourly / daily: the `forecast` lists from weather.get_forecasts. yday: the
    one-day row of recorder.get_statistics for sensor.outside_temperature
    (max / min), or none. Passed in because an imported macro cannot see the
    calling script's variables. -#}
{% macro weather_facts(hourly=[], daily=[], yday=none) -%}
{%- set hrs = hourly[:24] -%}
{%- set ns = namespace(windows=[], start=none, end=none, peak=0, winds=[], wstart=none, wend=none, hi=none, lo=none, gust=none, uv=none, cold=none) -%}
{%- for h in hrs -%}
{%- set p = h.precipitation_probability | default(0) | float(0) | round(0) | int -%}
{%- if p >= 30 -%}
{%- if ns.start is none %}{% set ns.start = h.datetime %}{% set ns.peak = 0 %}{% endif -%}
{%- set ns.end = h.datetime -%}
{%- set ns.peak = [ns.peak, p] | max -%}
{%- endif -%}
{%- if ns.start is not none and (p < 30 or loop.last) -%}
{%- set ns.windows = ns.windows + [as_local(as_datetime(ns.start)).strftime('%-I %p') ~ ' to ' ~ (as_local(as_datetime(ns.end)) + timedelta(hours=1)).strftime('%-I %p') ~ ' (up to ' ~ ns.peak ~ '%)'] -%}
{%- set ns.start = none -%}
{%- endif -%}
{%- set g = h.wind_gust_speed | default(0) | float(0) -%}
{%- if g >= 20 -%}
{%- if ns.wstart is none %}{% set ns.wstart = h.datetime %}{% endif -%}
{%- set ns.wend = h.datetime -%}
{%- endif -%}
{%- if ns.wstart is not none and (g < 20 or loop.last) -%}
{%- set ns.winds = ns.winds + [as_local(as_datetime(ns.wstart)).strftime('%-I %p') ~ ' to ' ~ (as_local(as_datetime(ns.wend)) + timedelta(hours=1)).strftime('%-I %p %A')] -%}
{%- set ns.wstart = none -%}
{%- endif -%}
{%- if ns.hi is none or h.temperature > ns.hi.temperature %}{% set ns.hi = h %}{% endif -%}
{%- if ns.lo is none or h.temperature < ns.lo.temperature %}{% set ns.lo = h %}{% endif -%}
{%- if ns.cold is none or h.apparent_temperature | default(h.temperature) < ns.cold.apparent_temperature | default(ns.cold.temperature) %}{% set ns.cold = h %}{% endif -%}
{%- if ns.gust is none or h.wind_gust_speed | default(0) > ns.gust.wind_gust_speed | default(0) %}{% set ns.gust = h %}{% endif -%}
{%- if ns.uv is none or h.uv_index | default(0) > ns.uv.uv_index | default(0) %}{% set ns.uv = h %}{% endif -%}
{%- endfor -%}
{%- macro at(h) %}{{ as_local(as_datetime(h.datetime)).strftime('%-I %p %A') }}{% endmacro -%}
Time: {{ now().strftime('%A, %B %-d, %-I:%M %p') }}. Next sunset {{ as_local(as_datetime(state_attr('sun.sun','next_setting'))).strftime('%-I:%M %p %A') }}.
Now: {{ states('weather.outside_waterville_oh_usa') }}, {{ states('sensor.outside_temperature') }}°F, humidity {{ states('sensor.outside_humidity') }}%. Air quality index {{ states('sensor.erie_ohio_usa_air_quality_index') }}.
{% if ns.hi is not none -%}
Next 24 hours: high {{ ns.hi.temperature | round(0) | int }}° at {{ at(ns.hi) }}; low {{ ns.lo.temperature | round(0) | int }}° at {{ at(ns.lo) }}; coldest feels-like {{ ns.cold.apparent_temperature | default(ns.cold.temperature) | round(0) | int }}° at {{ at(ns.cold) }}{% if ns.gust.wind_gust_speed | default(0) >= 15 %}; strongest gust {{ ns.gust.wind_gust_speed | round(0) | int }} mph at {{ at(ns.gust) }}{% endif %}{% if ns.uv.uv_index | default(0) >= 3 %}; peak UV {{ ns.uv.uv_index }} at {{ at(ns.uv) }}{% endif %}.
Rain chance 30% or more: {{ ns.windows | join('; ') if ns.windows else 'none in the next 24 hours' }}.
Gusts of 20 mph or more: {{ ns.winds | join('; ') if ns.winds else 'none in the next 24 hours' }}.
Every 3 hours: {% for h in hrs[::3] %}{{ as_local(as_datetime(h.datetime)).strftime('%-I %p') }} {{ h.condition }} {{ h.temperature | round(0) | int }}° (feels {{ h.apparent_temperature | default(h.temperature) | round(0) | int }}°) rain {{ h.precipitation_probability | default(0) | round(0) | int }}%{{ '; ' if not loop.last }}{% endfor %}.
{% endif -%}
{#- The daily rain figure is the chance of any rain that day; labelled so the
    model takes rain timing from the hourly lines, not "rain all day". -#}
Daily (rain = chance of any rain at some point that day): {% for d in daily[:3] %}{{ as_local(as_datetime(d.datetime)).strftime('%A') }} {{ d.condition }}, high {{ d.temperature | round(0) | int }}°, low {{ d.templow | default('?') }}°, rain {{ d.precipitation_probability | default(0) | round(0) | int }}%{{ '; ' if not loop.last }}{% endfor %}.
{% if yday is not none and yday.max is defined and daily | count > 0 -%}
Today vs yesterday: today's forecast high {{ daily[0].temperature | round(0) | int }}° is {{ (daily[0].temperature - yday.max) | abs | round(0) | int }}° {{ 'warmer' if daily[0].temperature >= yday.max else 'colder' }} than yesterday's {{ yday.max | round(0) | int }}°.
{% endif -%}
{% if daily | count > 1 -%}
Tomorrow vs today: tomorrow's forecast high {{ daily[1].temperature | round(0) | int }}° is {{ (daily[1].temperature - daily[0].temperature) | abs | round(0) | int }}° {{ 'warmer' if daily[1].temperature >= daily[0].temperature else 'colder' }} than today's {{ daily[0].temperature | round(0) | int }}°.
{%- endif %}
{%- endmacro %}

{#- Sums one recorder.get_statistics series over [start, end): `key` is change
    for meters, or heat / cool for degree days (base 65°F) from daily means.
    per_week scales the sum to 7 days by the number of days that have data, so
    a series younger than the window still gives a fair weekly average. -#}
{% macro window_total(rows=[], start=none, end=none, key='change', per_week=false) -%}
{%- set ns = namespace(total=0, days=0) -%}
{%- for r in rows if start <= as_datetime(r.start) < end -%}
{%- if key == 'heat' %}{% set v = [65 - r.mean | float(65), 0] | max %}{% elif key == 'cool' %}{% set v = [r.mean | float(65) - 65, 0] | max %}{% else %}{% set v = r[key] | float(0) %}{% endif -%}
{%- set ns.total = ns.total + v -%}
{%- set ns.days = ns.days + 1 -%}
{%- endfor -%}
{{- ((ns.total / ns.days * 7) if per_week and ns.days > 0 else ns.total) | round(1) -}}
{%- endmacro %}

{#- Describes `now` against `before` in words ("47% less", "about the same"),
    so the model states comparisons instead of computing them. Doubling or more
    reads as a multiple ("24 times as much"), and a drop to zero as "none",
    because "2300% more" or "100% less" off a tiny baseline reads as alarm. -#}
{% macro vs(now=0, before=0) -%}
{%- set a = now | float(0) -%}{%- set b = before | float(0) -%}
{%- if b == 0 -%}{{ 'none either time' if a == 0 else 'up from none' }}
{%- elif a == 0 -%}none, down from {{ b | round(1) }}
{%- elif a >= b * 2 -%}{%- set x = a / b -%}about {{ x | round(1) if x < 3 else x | round(0) | int }} times as much
{%- else -%}{%- set pct = ((a - b) / b * 100) | round(0) | int -%}
{{- 'about the same' if pct | abs < 10 else (pct | abs ~ '% ' ~ ('more' if pct > 0 else 'less')) -}}
{%- endif -%}
{%- endmacro %}

{#- Morning house recap: what happened overnight and yesterday (which the
    chips can't show, since they show only now) and what the house needs
    today. stats: recorder.get_statistics (period day, change) covering the
    last 8 days. Overnight counts come from the history_stats sensors in
    ha/packages/ai_insights.yaml (since 10 PM). -#}
{% macro house_facts(stats={}) -%}
{%- set t = today_at() -%}
{%- set y = t - timedelta(days=1) -%}
{%- set w = t - timedelta(days=8) -%}
{%- set e = stats.get('sensor.household_energy_monitor_total_energy_delivered', []) -%}
{%- set hh = stats.get('sensor.household_hvac_heating_runtime_today', []) -%}
{%- set ch = stats.get('sensor.household_hvac_cooling_runtime_today', []) -%}
{%- set e_y = window_total(e, y, t) | float(0) -%}{%- set e_typ = (window_total(e, w, y, 'change', true) | float(0) / 7) | round(1) -%}
{%- set h_y = window_total(hh, y, t) | float(0) -%}{%- set h_typ = (window_total(hh, w, y, 'change', true) | float(0) / 7) | round(1) -%}
{%- set c_y = window_total(ch, y, t) | float(0) -%}{%- set c_typ = (window_total(ch, w, y, 'change', true) | float(0) / 7) | round(1) -%}
{%- set doors = states('sensor.household_doors_opened_overnight') | int(0) -%}
{%- set last_door = states.binary_sensor.household_exterior_doors_open.last_changed if states.binary_sensor.household_exterior_doors_open is not none else none -%}
{%- set leaks = label_entities('water_leak_sensor') | select('is_state','on') | map('state_attr','friendly_name') | list -%}
{%- set chores = expand(integration_entities('chore_calendar') | select('match','sensor\\.') | list) -%}
{%- set ns = namespace(today=[]) -%}
{%- for c in chores -%}
{%- set due = c.attributes.next_due or (c.attributes.schedule.due_datetime if c.attributes.schedule is mapping else none) -%}
{%- set name = c.name | replace('Household Chores ', '') -%}
{%- if c.state == 'overdue' %}{% set ns.today = ns.today + [name ~ ' (overdue)'] %}
{%- elif c.state != 'completed' and due and as_datetime(due).date() == now().date() %}{% set ns.today = ns.today + [name ~ ' (due ' ~ as_local(as_datetime(due)).strftime('%-I %p') ~ ')'] %}
{%- endif -%}
{%- endfor -%}
Overnight (since 10 PM): exterior doors opened {{ doors }} time{{ 's' if doors != 1 }}{% if doors > 0 and last_door is not none and last_door >= today_at('22:00') - timedelta(days=1) %} (last activity {{ as_local(last_door).strftime('%-I:%M %p') }}){% endif %}; garage door opened {{ states('sensor.household_garage_opened_overnight') | int(0) }} times; internet dropped {{ states('sensor.household_internet_drops_overnight') | int(0) }} times; generator ran {{ states('sensor.household_generator_runs_overnight') | int(0) }} times. Doors and garage right now: front door {{ states('lock.entrance_front_door') }}, garage {{ states('cover.garage_door_opener_door') }}.
Water leaks right now: {{ leaks | join(', ') if leaks else 'none' }}.
Yesterday's electricity: {{ e_y }} kWh; a typical day this past week {{ e_typ }} kWh (yesterday: {{ vs(e_y, e_typ) }}).
Yesterday's heating: {{ h_y }} h (typical {{ h_typ }} h, {{ vs(h_y, h_typ) }}); cooling {{ c_y }} h (typical {{ c_typ }} h, {{ vs(c_y, c_typ) }}).
{% if now().hour < 8 -%}
{#- The ran flags reset at 08:00, so after that they describe today, not yesterday. -#}
Vacuum yesterday: daytime clean {{ 'done' if is_state('input_boolean.vacuum_ran_daytime','on') else 'did not run' }}, night clean {{ 'done' if is_state('input_boolean.vacuum_ran_evening','on') else 'did not run' }}.
{% endif -%}
Mopping this week (weekly, since Monday; today is {{ now().strftime('%A') }}): common areas {{ 'done' if is_state('input_boolean.vacuum_mop_common_areas_done_this_week','on') else 'not done yet' }}; master suite {{ 'done' if is_state('input_boolean.vacuum_mop_master_suite_done_this_week','on') else 'not done yet' }}.
Laundry: washer {{ 'finished and waiting to be unloaded' if is_state('input_select.utility_room_washer_status','alerting') else 'nothing waiting' }}; dryer {{ 'finished and waiting to be unloaded' if is_state('input_select.utility_room_dryer_status','alerting') else 'nothing waiting' }}.
Chores due today or overdue: {{ ns.today | join(', ') if ns.today else 'none' }}.
{%- endmacro %}

{#- ===== Climate and Energy insights (issue #18) =====
    Each macro returns JSON {"flags": [...], "facts": "..."}. Flags come from
    fixed rules here, never from the model: with no flag the script stores
    "nothing notable" without calling Claude. stats: recorder.get_statistics,
    period day, types mean/min/max/change, covering at least 35 days.
    days_ago picks the day reported on (1 = yesterday) so past days can be
    backtested. Occupancy (sensor.household_occupied_today, daily max hours)
    splits days into home / partial / away; baselines use home days only, and
    days with no occupancy data count as home. -#}

{#- One statistics series as {"YYYY-MM-DD": value}. -#}
{% macro _by_day(rows=[], field='change') -%}
{%- set ns = namespace(d={}) -%}
{%- for r in rows if r[field] is defined and r[field] is not none -%}
{%- set ns.d = dict(ns.d, **{(as_local(as_datetime(r.start)).date() | string): r[field] | float(0)}) -%}
{%- endfor -%}
{{- ns.d | to_json -}}
{%- endmacro %}

{#- home: 12 h or more home (a workday out still counts); away: under 2 h. -#}
{% macro _day_kind(occ={}, d='') -%}
{%- set h = occ.get(d) -%}
{{- 'home' if h is none or h >= 12 else ('away' if h < 2 else 'partial') -}}
{%- endmacro %}

{#- Each room's temperature minus the house median that day, when at least
    four rooms reported. -#}
{% macro _offsets(temps={}, d='') -%}
{%- set v = namespace(l=[], o={}) -%}
{%- for name, m in temps.items() if d in m %}{% set v.l = v.l + [m[d]] %}{% endfor -%}
{%- if v.l | count >= 4 -%}
{%- set l = v.l | sort -%}{%- set n = l | count -%}
{%- set med = l[n // 2] if n % 2 == 1 else (l[n // 2 - 1] + l[n // 2]) / 2 -%}
{%- for name, m in temps.items() if d in m %}{% set v.o = dict(v.o, **{name: m[d] - med}) %}{% endfor -%}
{%- endif -%}
{{- v.o | to_json -}}
{%- endmacro %}

{% macro _dates(days_ago=1) -%}
{%- set base = today_at() - timedelta(days=days_ago) -%}
{%- set ns = namespace(t28=[], w=[], wt=[]) -%}
{%- for i in range(1, 29) %}{% set ns.t28 = ns.t28 + [(base - timedelta(days=i)).date() | string] %}{% endfor -%}
{%- for i in range(0, 7) %}{% set ns.w = ns.w + [(base - timedelta(days=i)).date() | string] %}{% endfor -%}
{%- for i in range(7, 35) %}{% set ns.wt = ns.wt + [(base - timedelta(days=i)).date() | string] %}{% endfor -%}
{{- {'y': base.date() | string, 'label': base.strftime('%A, %B %-d'), 't28': ns.t28, 'w': ns.w, 'wt': ns.wt} | to_json -}}
{%- endmacro %}

{% macro _occupancy_line(occ={}, d='') -%}
{%- set k = _day_kind(occ, d) -%}{%- set h = occ.get(d) -%}
{{- 'no occupancy data' if h is none else ('someone home most of the day' if k == 'home' else ('away all day' if k == 'away' else 'home only ' ~ (h | round(0) | int) ~ ' h')) -}}
{%- endmacro %}

{#- Rules (thresholds from the Oct 2026 backtest; re-test tracked in #18):
    HVAC: runtime >= 1.5 h and >= 1.5x + 1 h over what the trailing 28 home
      days' hours per degree day predict (needs 10+ degree days of baseline);
      only on a home day that follows a home day, so setback recovery after
      time away never flags. Weekly: >= 3 h and >= 1.5x + 2 h.
    Room temperature: a room's offset from the house median is 2.5 F or more
      from its usual offset (trailing 14 home days). Utility Room excluded:
      it always runs ~10 F warm and dry.
    Humidity: a room's daily mean outside 40-60%. Weekly: 3+ such days. -#}
{% macro climate_insight(stats={}, days_ago=1, weekly=false) -%}
{%- set D = _dates(days_ago) | from_json -%}{%- set y = D.y -%}
{%- set occ = _by_day(stats.get('sensor.household_occupied_today', []), 'max') | from_json -%}
{%- set out = _by_day(stats.get('sensor.outside_temperature', []), 'mean') | from_json -%}
{%- set hi = _by_day(stats.get('sensor.outside_temperature', []), 'max') | from_json -%}
{%- set lo = _by_day(stats.get('sensor.outside_temperature', []), 'min') | from_json -%}
{%- set hvac = {'heating': _by_day(stats.get('sensor.household_hvac_heating_runtime_today', [])) | from_json,
                'cooling': _by_day(stats.get('sensor.household_hvac_cooling_runtime_today', [])) | from_json} -%}
{%- set rooms = [['Living Room', 'living_room_thermostat'], ['Kitchen', 'kitchen_climate'], ['Family Room', 'family_room_climate'], ['Office', 'office_climate'], ['Master Bedroom', 'master_bedroom_climate'], ["Avery's Room", 'averys_room_climate']] -%}
{%- set m = namespace(t={}, h={}) -%}
{%- for r in rooms -%}
{%- set m.t = dict(m.t, **{r[0]: _by_day(stats.get('sensor.' ~ r[1] ~ '_temperature', []), 'mean') | from_json}) -%}
{%- set m.h = dict(m.h, **{r[0]: _by_day(stats.get('sensor.' ~ r[1] ~ '_humidity', []), 'mean') | from_json}) -%}
{%- endfor -%}
{%- set yk = _day_kind(occ, y) -%}{%- set prev_home = _day_kind(occ, D.t28[0]) == 'home' -%}
{%- set f = namespace(flags=[], lines=[]) -%}
{%- set f.lines = f.lines + ['Yesterday (' ~ D.label ~ '): outdoor average ' ~ (out.get(y, 0) | round(0) | int) ~ '°F, high ' ~ (hi.get(y, 0) | round(0) | int) ~ '°, low ' ~ (lo.get(y, 0) | round(0) | int) ~ '°; ' ~ _occupancy_line(occ, y) ~ '.'] -%}
{%- set f.lines = f.lines + ['The thermostat holds the average of Living Room, Kitchen and Office by day, and of Avery\'s Room and Master Bedroom at night.'] -%}
{%- for kind in ['heating', 'cooling'] -%}
{%- set s = namespace(h=0, dd=0) -%}
{%- for d in D.t28 if d in out and _day_kind(occ, d) == 'home' -%}
{%- set s.h = s.h + hvac[kind].get(d, 0) -%}
{%- set s.dd = s.dd + ([65 - out[d], 0] | max if kind == 'heating' else [out[d] - 65, 0] | max) -%}
{%- endfor -%}
{%- set ddy = [65 - out.get(y, 65), 0] | max if kind == 'heating' else [out.get(y, 65) - 65, 0] | max -%}
{%- set act = hvac[kind].get(y, 0) -%}
{%- set exp = (s.h / s.dd * ddy) if s.dd >= 10 else none -%}
{%- set f.lines = f.lines + [kind | capitalize ~ ': did not run.' if act < 0.1 and (exp or 0) < 0.5 else kind | capitalize ~ ': ran ' ~ (act | round(1)) ~ ' h with ' ~ (ddy | round(0) | int) ~ ' ' ~ kind ~ ' degree days; ' ~ ('no recent baseline to compare.' if exp is none else 'the weather predicted about ' ~ (exp | round(1)) ~ ' h from recent home days (' ~ vs(act, exp) ~ ').')] -%}
{%- if yk == 'home' and prev_home and exp is not none and act >= 1.5 and act >= exp * 1.5 + 1 -%}
{%- set f.flags = f.flags + [kind | capitalize ~ ' ran ' ~ (act | round(1)) ~ ' h, more than the weather explains (about ' ~ (exp | round(1)) ~ ' h expected)'] -%}
{%- endif -%}
{%- endfor -%}
{%- set oy = _offsets(m.t, y) | from_json -%}
{%- set rl = namespace(l=[]) -%}
{%- for r in rooms if r[0] in m.t and y in m.t[r[0]] -%}
{%- set name = r[0] -%}
{%- set rl.l = rl.l + [name ~ ' ' ~ (m.t[name][y] | round(0) | int) ~ '°' ~ ((' / ' ~ (m.h[name][y] | round(0) | int) ~ '%') if y in m.h[name] else '')] -%}
{%- set u = namespace(l=[]) -%}
{%- for d in D.t28[:14] if _day_kind(occ, d) == 'home' -%}
{%- set od = _offsets(m.t, d) | from_json -%}
{%- if name in od %}{% set u.l = u.l + [od[name]] %}{% endif -%}
{%- endfor -%}
{%- if yk == 'home' and name in oy and u.l | count >= 5 -%}
{%- set usual = u.l | sum / (u.l | count) -%}
{%- if (oy[name] - usual) | abs >= 2.5 -%}
{%- set f.flags = f.flags + [name ~ ' averaged ' ~ (oy[name] | abs | round(1)) ~ '° ' ~ ('warmer' if oy[name] > 0 else 'colder') ~ ' than the middle of the house; it usually runs ' ~ (usual | abs | round(1)) ~ '° ' ~ ('warmer' if usual > 0 else 'colder')] -%}
{%- endif -%}
{%- endif -%}
{%- if y in m.h[name] and (m.h[name][y] > 60 or m.h[name][y] < 40) -%}
{%- set f.flags = f.flags + [name ~ ' humidity averaged ' ~ (m.h[name][y] | round(0) | int) ~ '%, ' ~ ('above' if m.h[name][y] > 60 else 'below') ~ ' the 40–60% comfort range'] -%}
{%- endif -%}
{%- endfor -%}
{%- set f.lines = f.lines + ['Rooms yesterday (average temperature / humidity): ' ~ rl.l | join(', ') ~ '.'] -%}
{%- if weekly -%}
{%- set wk = namespace(home=0, thome=0) -%}
{%- for d in D.w if _day_kind(occ, d) == 'home' %}{% set wk.home = wk.home + 1 %}{% endfor -%}
{%- for d in D.wt if _day_kind(occ, d) == 'home' %}{% set wk.thome = wk.thome + 1 %}{% endfor -%}
{%- set f.lines = f.lines + ['This week (the 7 days ending yesterday): someone home ' ~ wk.home ~ ' of 7 days; the 4 weeks before averaged ' ~ ((wk.thome / 4) | round(0) | int) ~ ' home days a week.'] -%}
{%- for kind in ['heating', 'cooling'] -%}
{%- set s = namespace(h=0, dd=0, wh=0, wdd=0) -%}
{%- for d in D.wt if d in out and _day_kind(occ, d) == 'home' -%}
{%- set s.h = s.h + hvac[kind].get(d, 0) -%}
{%- set s.dd = s.dd + ([65 - out[d], 0] | max if kind == 'heating' else [out[d] - 65, 0] | max) -%}
{%- endfor -%}
{%- for d in D.w if d in out -%}
{%- set s.wh = s.wh + hvac[kind].get(d, 0) -%}
{%- set s.wdd = s.wdd + ([65 - out[d], 0] | max if kind == 'heating' else [out[d] - 65, 0] | max) -%}
{%- endfor -%}
{%- set exp = (s.h / s.dd * s.wdd) if s.dd >= 20 else none -%}
{%- set f.lines = f.lines + ['Week ' ~ kind ~ ': did not run.' if s.wh < 0.1 and (exp or 0) < 0.5 else 'Week ' ~ kind ~ ': ' ~ (s.wh | round(1)) ~ ' h with ' ~ (s.wdd | round(0) | int) ~ ' degree days; ' ~ ('no recent baseline to compare.' if exp is none else 'the 4 weeks before predict about ' ~ (exp | round(1)) ~ ' h for that weather (' ~ vs(s.wh, exp) ~ ').')] -%}
{%- if exp is not none and s.wh >= 3 and s.wh >= exp * 1.5 + 2 -%}
{%- set f.flags = f.flags + ['This week ' ~ kind ~ ' ran ' ~ (s.wh | round(1)) ~ ' h, more than the weather explains (about ' ~ (exp | round(1)) ~ ' h expected)'] -%}
{%- endif -%}
{%- endfor -%}
{%- for r in rooms -%}
{%- set c = namespace(n=0) -%}
{%- for d in D.w if d in m.h[r[0]] and (m.h[r[0]][d] > 60 or m.h[r[0]][d] < 40) %}{% set c.n = c.n + 1 %}{% endfor -%}
{%- if c.n >= 3 %}{% set f.flags = f.flags + [r[0] ~ ' humidity was outside 40–60% on ' ~ c.n ~ ' of the last 7 days'] %}{% endif -%}
{%- endfor -%}
{%- endif -%}
{{- {'flags': f.flags, 'facts': f.lines | join('\n')} | to_json -}}
{%- endmacro %}

{#- Rules (thresholds from the Oct 2026 backtest; re-test tracked in #18):
    Electricity: yesterday >= 1.4x and >= 6 kWh above the trailing 28 home
      days' average, on a home day. Weekly: the week's home-day average
      >= 1.15x the trailing 4 weeks' and >= 15 kWh more over a week.
    Refrigerator: weekly only (daily swings of 25% are normal); the week
      15% and 1 kWh or more off the trailing 4 weeks, scaled to a week. -#}
{% macro energy_insight(stats={}, days_ago=1, weekly=false, rate=0.2033) -%}
{%- set D = _dates(days_ago) | from_json -%}{%- set y = D.y -%}
{%- set occ = _by_day(stats.get('sensor.household_occupied_today', []), 'max') | from_json -%}
{%- set e = _by_day(stats.get('sensor.household_energy_monitor_total_energy_delivered', [])) | from_json -%}
{%- set fr = _by_day(stats.get('sensor.kitchen_refrigerator_summation_delivered', [])) | from_json -%}
{%- set heat = _by_day(stats.get('sensor.household_hvac_heating_runtime_today', [])) | from_json -%}
{%- set cool = _by_day(stats.get('sensor.household_hvac_cooling_runtime_today', [])) | from_json -%}
{%- set yk = _day_kind(occ, y) -%}
{%- set f = namespace(flags=[], lines=[]) -%}
{%- set t = namespace(l=[]) -%}
{%- for d in D.t28 if d in e and _day_kind(occ, d) == 'home' %}{% set t.l = t.l + [e[d]] %}{% endfor -%}
{%- set ey = e.get(y, 0) -%}
{%- set typ = (t.l | sum / (t.l | count)) if t.l | count >= 7 else none -%}
{%- set f.lines = f.lines + ['Yesterday (' ~ D.label ~ '): ' ~ (ey | round(1)) ~ ' kWh (about $' ~ '%.2f' | format(ey * rate) ~ '); ' ~ _occupancy_line(occ, y) ~ '; heating ran ' ~ (heat.get(y, 0) | round(1)) ~ ' h, cooling ' ~ (cool.get(y, 0) | round(1)) ~ ' h.'] -%}
{%- if typ is not none -%}
{%- set f.lines = f.lines + ['A typical home day over the past 4 weeks used ' ~ (typ | round(1)) ~ ' kWh (yesterday: ' ~ vs(ey, typ) ~ ').'] -%}
{%- if yk == 'home' and ey >= typ * 1.4 and ey - typ >= 6 -%}
{%- set f.flags = f.flags + ['Yesterday used ' ~ (ey | round(1)) ~ ' kWh, well above a typical home day (' ~ (typ | round(1)) ~ ' kWh)'] -%}
{%- endif -%}
{%- endif -%}
{%- if weekly -%}
{%- set w = namespace(sum=0, home=[], thome=[], fw=0, ft=0, fn=0, wh=0, wc=0, th=0, tc=0) -%}
{%- for d in D.w if d in e -%}
{%- set w.sum = w.sum + e[d] -%}
{%- if _day_kind(occ, d) == 'home' %}{% set w.home = w.home + [e[d]] %}{% endif -%}
{%- endfor -%}
{%- for d in D.wt if d in e and _day_kind(occ, d) == 'home' %}{% set w.thome = w.thome + [e[d]] %}{% endfor -%}
{%- for d in D.w %}{% set w.fw = w.fw + fr.get(d, 0) %}{% set w.wh = w.wh + heat.get(d, 0) %}{% set w.wc = w.wc + cool.get(d, 0) %}{% endfor -%}
{%- for d in D.wt if d in fr %}{% set w.ft = w.ft + fr[d] %}{% set w.fn = w.fn + 1 %}{% endfor -%}
{%- for d in D.wt %}{% set w.th = w.th + heat.get(d, 0) %}{% set w.tc = w.tc + cool.get(d, 0) %}{% endfor -%}
{%- set f.lines = f.lines + ['This week (the 7 days ending yesterday): ' ~ (w.sum | round(1)) ~ ' kWh (about $' ~ '%.2f' | format(w.sum * rate) ~ '); someone home ' ~ w.home | count ~ ' of 7 days; heating ran ' ~ (w.wh | round(1)) ~ ' h and cooling ' ~ (w.wc | round(1)) ~ ' h (the 4 weeks before averaged ' ~ ((w.th / 4) | round(1)) ~ ' h and ' ~ ((w.tc / 4) | round(1)) ~ ' h a week).'] -%}
{%- if w.home | count >= 3 and w.thome | count >= 14 -%}
{%- set a = w.home | sum / (w.home | count) -%}{%- set b = w.thome | sum / (w.thome | count) -%}
{%- set f.lines = f.lines + ['Per home day: ' ~ (a | round(1)) ~ ' kWh this week, ' ~ (b | round(1)) ~ ' kWh over the 4 weeks before (' ~ vs(a, b) ~ ').'] -%}
{%- if a >= b * 1.15 and (a - b) * 7 >= 15 -%}
{%- set f.flags = f.flags + ['This week averaged ' ~ (a | round(1)) ~ ' kWh per home day, above the recent ' ~ (b | round(1)) ~ ' kWh'] -%}
{%- endif -%}
{%- endif -%}
{%- if w.fn >= 14 -%}
{%- set fa = w.ft / w.fn * 7 -%}
{%- set f.lines = f.lines + ['Refrigerator: ' ~ (w.fw | round(1)) ~ ' kWh this week; the 4 weeks before averaged ' ~ (fa | round(1)) ~ ' kWh a week (' ~ vs(w.fw, fa) ~ ').'] -%}
{%- if (w.fw - fa) | abs >= fa * 0.15 and (w.fw - fa) | abs >= 1 -%}
{%- set f.flags = f.flags + ['The refrigerator used ' ~ (w.fw | round(1)) ~ ' kWh this week, ' ~ vs(w.fw, fa) ~ ' than its usual ' ~ (fa | round(1)) ~ ' kWh'] -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{{- {'flags': f.flags, 'facts': f.lines | join('\n')} | to_json -}}
{%- endmacro %}
