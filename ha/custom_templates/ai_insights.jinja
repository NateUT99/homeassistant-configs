{#-
  Facts sent to Claude by script.household_ai_briefing and _house_summary
  (guides/ai_insights.md). This macro IS the allowlist: anything not listed here
  is never sent. Never add coordinates, lock codes, network details, camera
  images, or calendars.

  Deployed to /config/custom_templates/ai_insights.jinja; reload with
  homeassistant.reload_custom_templates after every change.

  hourly / daily: the `forecast` lists from weather.get_forecasts, passed in
  because an imported macro cannot see the calling script's variables.
-#}
{% macro house_facts(hourly=[], daily=[]) -%}
{%- set openings = expand('binary_sensor.household_exterior_openings') | selectattr('state','eq','on') | map(attribute='name') | list -%}
{%- set chores = expand(integration_entities('chore_calendar') | select('match','sensor\\.') | list) | selectattr('state','in',['due','overdue']) | list -%}
{%- set vac_parts = {'sensor.living_room_vacuum_filter_time_left': 'replace filter', 'sensor.living_room_vacuum_filter_clean_time_left': 'clean filter', 'sensor.living_room_vacuum_main_brush_time_left': 'main brush', 'sensor.living_room_vacuum_side_brush_time_left': 'side brush', 'sensor.living_room_vacuum_sensor_time_left': 'clean sensors'} -%}
{%- set ns = namespace(due=[]) -%}
{%- for e, label in vac_parts.items() if states(e) | float(999) <= 0 %}{% set ns.due = ns.due + [label] %}{% endfor -%}
{%- set leaks = label_entities('water_leak_sensor') | select('is_state','on') | map('state_attr','friendly_name') | list -%}
Time: {{ now().strftime('%A, %B %-d, %-I:%M %p') }}
Weather now: {{ states('weather.outside_waterville_oh_usa') }}, {{ states('sensor.outside_temperature') }}°F, humidity {{ states('sensor.outside_humidity') }}%.
Next 12 hours: {% for h in hourly[:12] %}{{ as_local(as_datetime(h.datetime)).strftime('%-I%p') }} {{ h.condition }} {{ h.temperature | round(0) | int }}° rain {{ h.precipitation_probability | default(0) }}%{{ '; ' if not loop.last }}{% endfor %}.
Daily: {% for d in daily[:2] %}{{ as_local(as_datetime(d.datetime)).strftime('%A') }} {{ d.condition }} high {{ d.temperature | round(0) | int }}° low {{ d.templow | default('?') }}° rain {{ d.precipitation_probability | default(0) }}%{{ '; ' if not loop.last }}{% endfor %}.
Outdoor air quality (AQI): {{ states('sensor.erie_ohio_usa_air_quality_index') }}.
Indoors: {{ state_attr('climate.living_room_thermostat','current_temperature') }}°F; thermostat mode {{ states('climate.living_room_thermostat') }}; fireplace {{ states('climate.living_room_fireplace') }}{{ '; HVAC paused because a door or window is open' if not is_state('input_select.household_hvac_mode_before_pause','none') }}.
Front door: {{ states('lock.entrance_front_door') }}, {{ 'open' if is_state('binary_sensor.entrance_front_door','on') else 'closed' }}. Garage door: {{ states('cover.garage_door_opener_door') }}.
Open doors/windows: {{ openings | join(', ') if openings else 'none' }}.
People physically home right now: {{ states('zone.home') }}; guest mode {{ states('input_boolean.guest_mode') }}; today is one of Avery's scheduled days with us: {{ 'yes' if is_state('binary_sensor.avery_home_today','on') else 'no' }} (schedule only, not presence); Avery asleep: {{ states('input_boolean.avery_sleeping') }}; everyone asleep: {{ states('input_boolean.everyone_sleeping') }}.
Chores due: {{ chores | map(attribute='name') | map('replace','Household Chores ','') | join(', ') if chores else 'none' }}{% for c in chores if c.state == 'overdue' %}{% if loop.first %} (overdue: {% endif %}{{ c.name | replace('Household Chores ','') }}{{ ', ' if not loop.last else ')' }}{% endfor %}.
Vacuum: {{ states('vacuum.living_room_vacuum') }}; ran today: {{ 'yes' if is_state('input_boolean.vacuum_ran_daytime','on') or is_state('input_boolean.vacuum_ran_evening','on') else 'no' }}; error: {{ states('sensor.living_room_vacuum_vacuum_error') }}; maintenance overdue: {{ ns.due | join(', ') if ns.due else 'none' }}.
Laundry: washer {{ states('input_select.utility_room_washer_status') }} ({{ states('sensor.utility_room_washer_current_status') }}), dryer {{ states('input_select.utility_room_dryer_status') }} ({{ states('sensor.utility_room_dryer_current_status') }}); dishwasher {{ 'running' if is_state('binary_sensor.kitchen_dishwasher_running','on') else 'idle' }}.
Water leaks: {{ leaks | join(', ') if leaks else 'none' }}.
Generator: {{ states('sensor.outside_home_generator_status') }}. Internet: {{ 'up' if is_state('binary_sensor.utility_room_firewalla_gold_se_wan_buckeye_broadband_status','on') else 'DOWN' }}.
{%- endmacro %}
