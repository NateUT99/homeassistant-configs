{#-
  Facts sent to Claude by script.household_ai_briefing and _weekly_digest
  (guides/ai_insights.md). These macros ARE the allowlist: anything not listed
  here is never sent. Never add coordinates, lock codes, network details, camera
  images, or calendars.

  Deployed to /config/custom_templates/ai_insights.jinja; reload with
  homeassistant.reload_custom_templates after every change.

  Everything the model would otherwise have to work out (highs and lows and
  their times, rain windows, the gap to yesterday) is computed here, so the
  model only has to write.
-#}

{#- hourly / daily: the `forecast` lists from weather.get_forecasts. yday: the
    one-day row of recorder.get_statistics for sensor.outside_temperature
    (max / min), or none. Passed in because an imported macro cannot see the
    calling script's variables. -#}
{% macro weather_facts(hourly=[], daily=[], yday=none) -%}
{%- set hrs = hourly[:24] -%}
{%- set ns = namespace(windows=[], start=none, end=none, peak=0, winds=[], wstart=none, wend=none, hi=none, lo=none, gust=none, uv=none, cold=none) -%}
{%- for h in hrs -%}
{%- set p = h.precipitation_probability | default(0) | float(0) | round(0) | int -%}
{%- if p >= 30 -%}
{%- if ns.start is none %}{% set ns.start = h.datetime %}{% set ns.peak = 0 %}{% endif -%}
{%- set ns.end = h.datetime -%}
{%- set ns.peak = [ns.peak, p] | max -%}
{%- endif -%}
{%- if ns.start is not none and (p < 30 or loop.last) -%}
{%- set ns.windows = ns.windows + [as_local(as_datetime(ns.start)).strftime('%-I %p') ~ ' to ' ~ (as_local(as_datetime(ns.end)) + timedelta(hours=1)).strftime('%-I %p') ~ ' (up to ' ~ ns.peak ~ '%)'] -%}
{%- set ns.start = none -%}
{%- endif -%}
{%- set g = h.wind_gust_speed | default(0) | float(0) -%}
{%- if g >= 20 -%}
{%- if ns.wstart is none %}{% set ns.wstart = h.datetime %}{% endif -%}
{%- set ns.wend = h.datetime -%}
{%- endif -%}
{%- if ns.wstart is not none and (g < 20 or loop.last) -%}
{%- set ns.winds = ns.winds + [as_local(as_datetime(ns.wstart)).strftime('%-I %p') ~ ' to ' ~ (as_local(as_datetime(ns.wend)) + timedelta(hours=1)).strftime('%-I %p %A')] -%}
{%- set ns.wstart = none -%}
{%- endif -%}
{%- if ns.hi is none or h.temperature > ns.hi.temperature %}{% set ns.hi = h %}{% endif -%}
{%- if ns.lo is none or h.temperature < ns.lo.temperature %}{% set ns.lo = h %}{% endif -%}
{%- if ns.cold is none or h.apparent_temperature | default(h.temperature) < ns.cold.apparent_temperature | default(ns.cold.temperature) %}{% set ns.cold = h %}{% endif -%}
{%- if ns.gust is none or h.wind_gust_speed | default(0) > ns.gust.wind_gust_speed | default(0) %}{% set ns.gust = h %}{% endif -%}
{%- if ns.uv is none or h.uv_index | default(0) > ns.uv.uv_index | default(0) %}{% set ns.uv = h %}{% endif -%}
{%- endfor -%}
{%- macro at(h) %}{{ as_local(as_datetime(h.datetime)).strftime('%-I %p %A') }}{% endmacro -%}
Time: {{ now().strftime('%A, %B %-d, %-I:%M %p') }}. Next sunset {{ as_local(as_datetime(state_attr('sun.sun','next_setting'))).strftime('%-I:%M %p %A') }}.
Now: {{ states('weather.outside_waterville_oh_usa') }}, {{ states('sensor.outside_temperature') }}°F, humidity {{ states('sensor.outside_humidity') }}%. Air quality index {{ states('sensor.erie_ohio_usa_air_quality_index') }}.
{% if ns.hi is not none -%}
Next 24 hours: high {{ ns.hi.temperature | round(0) | int }}° at {{ at(ns.hi) }}; low {{ ns.lo.temperature | round(0) | int }}° at {{ at(ns.lo) }}; coldest feels-like {{ ns.cold.apparent_temperature | default(ns.cold.temperature) | round(0) | int }}° at {{ at(ns.cold) }}{% if ns.gust.wind_gust_speed | default(0) >= 15 %}; strongest gust {{ ns.gust.wind_gust_speed | round(0) | int }} mph at {{ at(ns.gust) }}{% endif %}{% if ns.uv.uv_index | default(0) >= 3 %}; peak UV {{ ns.uv.uv_index }} at {{ at(ns.uv) }}{% endif %}.
Rain chance 30% or more: {{ ns.windows | join('; ') if ns.windows else 'none in the next 24 hours' }}.
Gusts of 20 mph or more: {{ ns.winds | join('; ') if ns.winds else 'none in the next 24 hours' }}.
Every 3 hours: {% for h in hrs[::3] %}{{ as_local(as_datetime(h.datetime)).strftime('%-I %p') }} {{ h.condition }} {{ h.temperature | round(0) | int }}° (feels {{ h.apparent_temperature | default(h.temperature) | round(0) | int }}°) rain {{ h.precipitation_probability | default(0) | round(0) | int }}%{{ '; ' if not loop.last }}{% endfor %}.
{% endif -%}
Daily: {% for d in daily[:3] %}{{ as_local(as_datetime(d.datetime)).strftime('%A') }} {{ d.condition }}, high {{ d.temperature | round(0) | int }}°, low {{ d.templow | default('?') }}°, rain {{ d.precipitation_probability | default(0) | round(0) | int }}%{{ '; ' if not loop.last }}{% endfor %}.
{% if yday is not none and yday.max is defined and daily | count > 0 -%}
Today vs yesterday: today's forecast high {{ daily[0].temperature | round(0) | int }}° is {{ (daily[0].temperature - yday.max) | abs | round(0) | int }}° {{ 'warmer' if daily[0].temperature >= yday.max else 'colder' }} than yesterday's {{ yday.max | round(0) | int }}°.
{% endif -%}
{% if daily | count > 1 -%}
Tomorrow vs today: tomorrow's forecast high {{ daily[1].temperature | round(0) | int }}° is {{ (daily[1].temperature - daily[0].temperature) | abs | round(0) | int }}° {{ 'warmer' if daily[1].temperature >= daily[0].temperature else 'colder' }} than today's {{ daily[0].temperature | round(0) | int }}°.
{%- endif %}
{%- endmacro %}

{#- Sums one recorder.get_statistics series over [start, end): `key` is change
    for meters, or heat / cool for degree days (base 65°F) from daily means.
    per_week scales the sum to 7 days by the number of days that have data, so
    a series younger than the window still gives a fair weekly average. -#}
{% macro window_total(rows=[], start=none, end=none, key='change', per_week=false) -%}
{%- set ns = namespace(total=0, days=0) -%}
{%- for r in rows if start <= as_datetime(r.start) < end -%}
{%- if key == 'heat' %}{% set v = [65 - r.mean | float(65), 0] | max %}{% elif key == 'cool' %}{% set v = [r.mean | float(65) - 65, 0] | max %}{% else %}{% set v = r[key] | float(0) %}{% endif -%}
{%- set ns.total = ns.total + v -%}
{%- set ns.days = ns.days + 1 -%}
{%- endfor -%}
{{- ((ns.total / ns.days * 7) if per_week and ns.days > 0 else ns.total) | round(1) -}}
{%- endmacro %}

{#- Describes `now` against `before` in words ("47% less", "about the same"),
    so the model states comparisons instead of computing them. -#}
{% macro vs(now=0, before=0) -%}
{%- set a = now | float(0) -%}{%- set b = before | float(0) -%}
{%- if b == 0 -%}{{ 'none either time' if a == 0 else 'up from none' }}
{%- else -%}{%- set pct = ((a - b) / b * 100) | round(0) | int -%}
{{- 'about the same' if pct | abs < 10 else (pct | abs ~ '% ' ~ ('more' if pct > 0 else 'less')) -}}
{%- endif -%}
{%- endmacro %}

{#- Morning house recap: what happened overnight and yesterday (which the
    chips can't show, since they show only now) and what the house needs
    today. stats: recorder.get_statistics (period day, change) covering the
    last 8 days. Overnight counts come from the history_stats sensors in
    ha/packages/ai_insights.yaml (since 10 PM). -#}
{% macro house_facts(stats={}) -%}
{%- set t = today_at() -%}
{%- set y = t - timedelta(days=1) -%}
{%- set w = t - timedelta(days=8) -%}
{%- set e = stats.get('sensor.household_energy_monitor_total_energy_delivered', []) -%}
{%- set hh = stats.get('sensor.household_hvac_heating_runtime_today', []) -%}
{%- set ch = stats.get('sensor.household_hvac_cooling_runtime_today', []) -%}
{%- set e_y = window_total(e, y, t) | float(0) -%}{%- set e_typ = (window_total(e, w, y, 'change', true) | float(0) / 7) | round(1) -%}
{%- set h_y = window_total(hh, y, t) | float(0) -%}{%- set h_typ = (window_total(hh, w, y, 'change', true) | float(0) / 7) | round(1) -%}
{%- set c_y = window_total(ch, y, t) | float(0) -%}{%- set c_typ = (window_total(ch, w, y, 'change', true) | float(0) / 7) | round(1) -%}
{%- set doors = states('sensor.household_doors_opened_overnight') | int(0) -%}
{%- set last_door = states.binary_sensor.household_exterior_doors_open.last_changed if states.binary_sensor.household_exterior_doors_open is not none else none -%}
{%- set leaks = label_entities('water_leak_sensor') | select('is_state','on') | map('state_attr','friendly_name') | list -%}
{%- set chores = expand(integration_entities('chore_calendar') | select('match','sensor\\.') | list) -%}
{%- set ns = namespace(today=[]) -%}
{%- for c in chores -%}
{%- set due = c.attributes.next_due or (c.attributes.schedule.due_datetime if c.attributes.schedule is mapping else none) -%}
{%- set name = c.name | replace('Household Chores ', '') -%}
{%- if c.state == 'overdue' %}{% set ns.today = ns.today + [name ~ ' (overdue)'] %}
{%- elif c.state != 'completed' and due and as_datetime(due).date() == now().date() %}{% set ns.today = ns.today + [name ~ ' (due ' ~ as_local(as_datetime(due)).strftime('%-I %p') ~ ')'] %}
{%- endif -%}
{%- endfor -%}
Overnight (since 10 PM): exterior doors opened {{ doors }} time{{ 's' if doors != 1 }}{% if doors > 0 and last_door is not none and last_door >= today_at('22:00') - timedelta(days=1) %} (last activity {{ as_local(last_door).strftime('%-I:%M %p') }}){% endif %}; garage door opened {{ states('sensor.household_garage_opened_overnight') | int(0) }} times; internet dropped {{ states('sensor.household_internet_drops_overnight') | int(0) }} times; generator ran {{ states('sensor.household_generator_runs_overnight') | int(0) }} times. Doors and garage right now: front door {{ states('lock.entrance_front_door') }}, garage {{ states('cover.garage_door_opener_door') }}.
Water leaks right now: {{ leaks | join(', ') if leaks else 'none' }}.
Yesterday's electricity: {{ e_y }} kWh; a typical day this past week {{ e_typ }} kWh (yesterday: {{ vs(e_y, e_typ) }}).
Yesterday's heating: {{ h_y }} h (typical {{ h_typ }} h, {{ vs(h_y, h_typ) }}); cooling {{ c_y }} h (typical {{ c_typ }} h, {{ vs(c_y, c_typ) }}).
{% if now().hour < 8 -%}
{#- The ran flags reset at 08:00, so after that they describe today, not yesterday. -#}
Vacuum yesterday: daytime clean {{ 'done' if is_state('input_boolean.vacuum_ran_daytime','on') else 'did not run' }}, night clean {{ 'done' if is_state('input_boolean.vacuum_ran_evening','on') else 'did not run' }}.
{% endif -%}
Laundry: washer {{ 'finished and waiting to be unloaded' if is_state('input_select.utility_room_washer_status','alerting') else 'nothing waiting' }}; dryer {{ 'finished and waiting to be unloaded' if is_state('input_select.utility_room_dryer_status','alerting') else 'nothing waiting' }}.
Chores due today or overdue: {{ ns.today | join(', ') if ns.today else 'none' }}.
{%- endmacro %}
