{#-
  Shared dashboard logic for home-main (standards/dashboards.md §9.2).
  Deployed to /config/custom_templates/dashboard.jinja; reload with
  homeassistant.reload_custom_templates after every change.

  Import in a Bubble Card template:
    {% from 'dashboard.jinja' import room_summary %}{{ room_summary('office', ...) }}
-#}

{#-
  Room tile / pop-up summary line, e.g. "2 lights on · Fan on · 69°".
  Hidden entities are excluded so switch LED bars, status LEDs, and light-group
  members don't count as room lights (LESSONS.md: an area's light.* entities
  include indicator LEDs and group members).
-#}
{#- Count of the area's visible lights that are on (shared by summary and glow). -#}
{% macro room_lights_on(area) -%}
{{- area_entities(area) | select('match', 'light\\.') | reject('is_hidden_entity') | select('is_state', 'on') | list | count -}}
{%- endmacro %}

{% macro room_summary(area, temp_sensor=none, fan=none) -%}
{%- set n = room_lights_on(area) | int -%}
{%- set parts = [] -%}
{%- if n > 0 %}{% set parts = parts + [n ~ (' light on' if n == 1 else ' lights on')] %}{% endif -%}
{%- if fan and is_state(fan, 'on') %}{% set parts = parts + ['Fan on'] %}{% endif -%}
{%- if temp_sensor and has_value(temp_sensor) %}{% set parts = parts + [states(temp_sensor) | float | round(0) | int ~ '°'] %}{% endif -%}
{{- parts | join(' · ') if parts else 'All off' -}}
{%- endmacro %}

{#-
  Severity for an open door/window/garage or an unlocked lock: 'red' when the
  household is asleep or nobody is home, otherwise 'amber'. Leaks are always
  red and do not use this.
-#}
{% macro alert_level() -%}
{{- 'red' if is_state('input_boolean.everyone_sleeping', 'on') or states('zone.home') | int(0) == 0 else 'amber' -}}
{%- endmacro %}

{#-
  Room tile glow (Bubble `styles`): a warm amber tint and halo while any of the
  area's lights are on, so lit rooms stand out in the #rooms pop-up.
-#}
{% macro room_glow(area) -%}
{%- if room_lights_on(area) | int > 0 -%}
.bubble-button-card-container { background: color-mix(in srgb, var(--amber-color) 16%, transparent) !important; box-shadow: 0 0 22px color-mix(in srgb, var(--amber-color) 22%, transparent), inset 0 0 0 1px color-mix(in srgb, var(--amber-color) 45%, transparent) !important; }
.bubble-background { background-color: transparent !important; }
.bubble-icon { color: var(--amber-color) !important; }
{%- endif -%}
{%- endmacro %}

{#-
  Progress-fill background for "Happening now" cards (Bubble `styles`): the card fills
  left to right to `pct` percent in the given theme colour (a CSS variable); pct=none
  gives an even tint for appliances that report no progress.
-#}
{% macro progress_fill(pct=none, color='var(--cyan-color)') -%}
{%- set p = pct | int(0) if pct is not none else 100 -%}
{%- set a = '32%' if pct is not none else '18%' -%}
.bubble-button-card-container { border-radius: 22px !important; background: color-mix(in srgb, var(--primary-text-color) 7%, transparent) !important; }
.bubble-background { opacity: 1 !important; background: linear-gradient(90deg, color-mix(in srgb, {{ color }} {{ a }}, transparent) {{ p }}%, transparent {{ p }}%) !important; }
.bubble-icon-container { background: {{ color }} !important; }
.bubble-icon { color: var(--primary-background-color) !important; }
{%- endmacro %}

{#-
  Category chips (Apple Home-style status row). Each *_status() returns the chip's one-line
  status; each *_color() returns the CSS colour for its icon (standards/dashboards.md §10).
  Areas whose lights count toward the house total live in house_light_areas().
-#}
{% macro house_light_areas() -%}
living_room,master_bedroom,averys_room,office,entertainment_room,kitchen,entrance,garage,outside,bathroom,utility_room
{%- endmacro %}

{% macro lights_on_count() -%}
{%- set ns = namespace(n=0) -%}
{%- for a in house_light_areas().split(',') %}{% set ns.n = ns.n + room_lights_on(a) | int %}{% endfor -%}
{{- ns.n -}}
{%- endmacro %}

{% macro weather_status() -%}
{%- set labels = {'clear-night': 'Clear', 'cloudy': 'Cloudy', 'exceptional': 'Alert', 'fog': 'Fog', 'hail': 'Hail', 'lightning': 'Storms', 'lightning-rainy': 'Storms', 'partlycloudy': 'Partly cloudy', 'pouring': 'Heavy rain', 'rainy': 'Rain', 'snowy': 'Snow', 'snowy-rainy': 'Sleet', 'sunny': 'Sunny', 'windy': 'Windy', 'windy-variant': 'Windy'} -%}
{%- set w = states('weather.outside_waterville_oh_usa') -%}
{%- set parts = [states('sensor.outside_temperature') | float(0) | round(0) | int ~ '° ' ~ labels.get(w, w | replace('-', ' ') | capitalize)] -%}
{%- set aqi = states('sensor.erie_ohio_usa_air_quality_index') | int(0) -%}
{%- if aqi > 50 %}{% set parts = parts + ['AQI ' ~ aqi] %}{% endif -%}
{{- parts | join(' · ') -}}
{%- endmacro %}

{% macro weather_icon() -%}
{%- set w = states('weather.outside_waterville_oh_usa') -%}
{%- set icons = {'clear-night': 'mdi:weather-night', 'partlycloudy': 'mdi:weather-partly-cloudy', 'exceptional': 'mdi:alert-circle-outline'} -%}
{{- icons.get(w, 'mdi:weather-' ~ w) -}}
{%- endmacro %}

{#- AQI uses the EPA scale's own colours, the one place orange stays (§10). -#}
{% macro weather_color() -%}
{%- set aqi = states('sensor.erie_ohio_usa_air_quality_index') | int(0) -%}
{{- 'var(--red-color)' if aqi > 150 else ('var(--orange-color)' if aqi > 100 else ('var(--yellow-color)' if aqi > 50 else 'var(--secondary-text-color)')) -}}
{%- endmacro %}

{% macro security_issues() -%}
{%- set ns = namespace(o=[]) -%}
{%- if not is_state('lock.entrance_front_door', 'locked') %}{% set ns.o = ns.o + ['Unlocked'] %}{% endif -%}
{%- if is_state('binary_sensor.entrance_front_door', 'on') %}{% set ns.o = ns.o + ['Door open'] %}{% endif -%}
{%- if not is_state('cover.garage_door_opener_door', 'closed') %}{% set ns.o = ns.o + ['Garage open'] %}{% endif -%}
{%- set n = expand('binary_sensor.household_exterior_openings') | rejectattr('entity_id', 'eq', 'binary_sensor.entrance_front_door') | selectattr('state', 'eq', 'on') | list | count -%}
{%- if n > 0 %}{% set ns.o = ns.o + [n ~ ' open'] %}{% endif -%}
{{- ns.o | join(' · ') -}}
{%- endmacro %}

{% macro security_status() -%}
{%- set i = security_issues() -%}
{{- i if i else 'Secure' -}}
{%- endmacro %}

{% macro security_color() -%}
{{- 'var(--' ~ alert_level() ~ '-color)' if security_issues() else 'var(--green-color)' -}}
{%- endmacro %}

{% macro water_status() -%}
{%- set wet = label_entities('water_leak_sensor') | select('is_state', 'on') | map('state_attr', 'friendly_name') | list -%}
{{- ('Leak: ' ~ wet | join(', ')) if wet else 'No leaks' -}}
{%- endmacro %}

{% macro media_playing_count() -%}
{#- Players with a room media card showing: playing or paused, same rule as the cards. -#}
{{- ['media_player.living_room_appletv', 'media_player.family_room_appletv', 'media_player.master_bedroom_appletv', 'media_player.kitchen_homepod', 'media_player.office_homepod', 'media_player.master_bedroom_homepod', 'media_player.averys_room_homepod'] | select('is_state', ['playing', 'paused']) | list | count -}}
{%- endmacro %}
